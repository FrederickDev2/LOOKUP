# =============================================================================
# UPT NIA Lookup — configuration
# Copy this file to ".env" and edit the values before first run.
#   cp .env.example .env
# NEVER commit the real .env file to version control.
# =============================================================================

# --- Session signing key -----------------------------------------------------
# Used to sign the login session cookie. MUST be a long random string.
# Generate one with:   python -c "import secrets; print(secrets.token_urlsafe(48))"
# If this changes, all users are logged out.
APP_SECRET_KEY=change-me-to-a-long-random-string

# --- Network binding ---------------------------------------------------------
# The local/private interface the app listens on.
# 127.0.0.1 = this machine only (safest). To serve the internal LAN, set this
# to the server's PRIVATE LAN IP (e.g. 192.168.10.5 or 10.0.0.5).
# DO NOT set this to 0.0.0.0 and DO NOT expose the app to the public internet.
APP_HOST=127.0.0.1
APP_PORT=8000

# --- Storage paths -----------------------------------------------------------
# SQLite database file and a scratch dir for temporary upload files.
APP_DB_PATH=./data/upt.db
APP_TMP_DIR=./data/tmp

# --- Session cookie ----------------------------------------------------------
# Set to true ONLY if the app is served over HTTPS. On a plain-HTTP LAN, false.
SESSION_COOKIE_SECURE=false
# Session lifetime in seconds (default 8 hours).
SESSION_MAX_AGE=28800

# --- Upload limits -----------------------------------------------------------
# Max size (MB) accepted for the admin data-import Excel file.
MAX_IMPORT_MB=300
# Max size (MB) accepted for a bulk-lookup list file.
MAX_BULK_MB=25

# =============================================================================
# Seed accounts — used ONLY by seed.py on first run to create the two default
# accounts. After seeding you may remove these lines. Passwords are stored in
# the database as bcrypt hashes; they are never persisted in plaintext.
# =============================================================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
QUERY_USERNAME=query
QUERY_PASSWORD=
